# ==============================================================================
# Vanguard SRE Control Plane — Environment Configuration Template
# Copy to .env: cp .env.example .env
# NEVER commit your populated .env file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core / Runtime
# ------------------------------------------------------------------------------
APP_URL=http://localhost:3000
PORT=3000

# Initial execution mode: AI_SANDBOX | MOCK_DEMO | LIVE_BRIDGE
# Defaults to AI_SANDBOX if any LLM key is set, otherwise MOCK_DEMO.
VANGUARD_MODE=AI_SANDBOX

# Primary LLM provider (Google Gemini: gemini-3.1-flash-lite default, gemini-4-hydrogen selectable)
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 2. Production Hardening (Zero Trust & Persistence)
# Generate strong 32-byte secrets with: openssl rand -hex 32
# ------------------------------------------------------------------------------
# Persistent HMAC-SHA256 key for the Transponder audit ledger (ephemeral random 32B if omitted)
TRANSPONDER_SECRET=

# Signing secret for server-issued TOTP 2FA session tokens (falls back to TRANSPONDER_SECRET or ephemeral)
TWO_FACTOR_SESSION_SECRET=

# Atomic JSON persistence file (globalTip, event chain, processedEffects, usedIdempotencyKeys)
VANGUARD_STATE_FILE=.vanguard-state.json

# Shared HMAC-SHA256 secret authenticating /ws/bridge envelopes with vanguard_bridge_agent.py
VANGUARD_BRIDGE_HMAC_SECRET=

# Optional HTTP/WS URL of an external bridge endpoint for health probing & LIVE_BRIDGE eligibility
VANGUARD_BRIDGE_URL=

# ------------------------------------------------------------------------------
# 3. Optional Integrations (Server-Side Only)
# ------------------------------------------------------------------------------
# Optional LLM providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_MODEL=gpt-4o-mini

# Read-only GitHub repository telemetry
GITHUB_TOKEN=
GITHUB_DEFAULT_REPO=

# Two-way Telegram operator control & inline Approval Gate alerts
TELEGRAM_BOT_TOKEN=
# Comma-separated allowlist of authorized chat IDs (e.g. 123456789,-100987654321)
TELEGRAM_ALLOWED_CHAT_IDS=
# Required only when exposing POST /api/telegram/webhook; leave empty to keep webhook disabled (503)
TELEGRAM_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# 4. Local Python Bridge Agent (vanguard_bridge_agent.py — client-side reference)
# ------------------------------------------------------------------------------
# VANGUARD_CONTROL_PLANE_WS=ws://localhost:3000/ws/bridge
# VANGUARD_WORKSPACE_DIR=./workspace
# VANGUARD_HEARTBEAT_SEC=15
